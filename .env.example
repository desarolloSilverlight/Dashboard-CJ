# Credenciales CJ (solo servidor — no se envían al navegador)
# El access token se obtiene con POST /authentication/getAccessToken
CJ_EMAIL=tu-correo@cjdropshipping.com
CJ_API_KEY=CJxxxxxxxx@api@xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Pausa entre llamadas batch (ms)
CJ_BATCH_DELAY_MS=120

# Intervalo mínimo entre llamadas a CJ (QPS=1). Default 1100 ms
CJ_QPS_INTERVAL_MS=1100

# TTL caché catálogo en el navegador (ms). Default 30 min
# NEXT_PUBLIC_CATALOG_CACHE_TTL_MS=1800000
